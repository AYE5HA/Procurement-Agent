ENVIRONMENT=development
ANALYSIS_PROVIDER=azure
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
FOUNDRY_MODEL_NAME=gpt-4o
